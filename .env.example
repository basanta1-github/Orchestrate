# ─── API ───────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string

API_PORT=3001

# ─── Database (PostgreSQL) ─────────────────────────────
DB_HOST=db
#up is with docker
#without docker down 
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=job_que

# For local dev WITHOUT Docker, use:
# DB_HOST=localhost

# ─── Redis / BullMQ ────────────────────────────────────
REDIS_HOST=redis
#up is with docker
#without docker down 
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# For local dev WITHOUT Docker, use:
# REDIS_HOST=localhost

# ─── Workers ───────────────────────────────────────────
# Set per worker container: email | etl | media | ml | report
WORKER_TYPE=media
METRICS_PORT=3001
SERVICE_NAME=api

# ─── Queue metrics (API only) ───────────────────────────
QUEUE_DEPTH_POLLER=true

# ─── Optional: S3 storage (M7+) ────────────────────────
USE_S3=false
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
USE_S3=

# ─── Optional: Email (M11+) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
HUNTER_API_KEY=

# ─── Optional: Dev tuning ──────────────────────────────
JOB_DEMO_DELAY_MS=0
CLEAN_TEMP_FILES=true