# ─── API ───────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# ─── Database (PostgreSQL) ─────────────────────────────
# Docker Compose: DB_HOST=db
# Local dev:       DB_HOST=127.0.0.1
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=job_que
DB_SYNCHRONIZE=true

# For local dev WITHOUT Docker, use:
# DB_HOST=localhost

# ─── Redis / BullMQ ────────────────────────────────────
# Docker Compose: REDIS_HOST=redis
# Local dev:       REDIS_HOST=127.0.0.1
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_DEPTH_POLLER=true

# ─── Workers ───────────────────────────────────────────
# Set per worker process: media | ml | email | etl | report only req when using 
# or running docker worker container not needed while we have to run all of them
# WORKER_TYPE=media
# METRICS_PORT=3001


# ─── Optional: S3 storage (M7+) ────────────────────────
USE_S3=false
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=



# ─── Optional: Email (M11+) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
HUNTER_API_KEY=

# ─── Optional: Dev tuning ──────────────────────────────
CLEAN_TEMP_FILES=true

# ─── Optional: Grafana (monitoring profile) ────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
SLACK_WEBHOOK_URL=-replace-with-your-slack-webhook-url


# ─── Queue metrics ─────────────────────────────────────
QUEUE_DEPTH_POLLER=true
# Do NOT set WORKER_TYPE at all (omit the line entirely)
# WORKER_TYPE=media   ← remove / never deploy this

CLEAN_TEMP_FILES=true
// false for debugging a failed pdf gen else in every cases true only used for that
JOB_DEMO_DELAY_MS= -- replace-me-with-desired-delay-in-ms-for-demo-jobs (e.g. 10000 for 10s)
TENANT_JOBS_PER_MINUTE=0
for the rate limit if 0 no any limit