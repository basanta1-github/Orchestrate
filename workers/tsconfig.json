{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src", 
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "paths": {
      "@jobque/shared": ["../shared/dist"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [ "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
